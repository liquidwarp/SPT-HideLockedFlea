<Project>
    <Target Name="CleanRelease" BeforeTargets="Build" Condition="'$(PackageRelease)' == 'True'">
        <RemoveDir Directories="$(ReleaseDir)" />
    </Target>

    <Target Name="ZipRelease" AfterTargets="Build" Condition="'$(PackageRelease)' == 'True'">
        <ZipDirectory SourceDirectory="$(ReleaseDir)" DestinationFile="$(ReleaseDir).zip" Overwrite="true" />
    </Target>
</Project>

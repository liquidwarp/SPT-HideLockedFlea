<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>HideLockedFleaServer</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <OutputType>Library</OutputType>
        <Version>1.0.0</Version>
        <AssemblyName>Liquidwarp.HideLockedFlea.Server</AssemblyName>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="SPTushonka.Common" Version="4.1.6" />
        <PackageReference Include="SPTushonka.DI" Version="4.1.6" />
        <PackageReference Include="SPTushonka.Reflection" Version="4.1.6" />
        <PackageReference Include="SPTushonka.Server.Core" Version="4.1.6" />
    </ItemGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <DebugType>None</DebugType>
        <DebugSymbols>false</DebugSymbols>
        <GenerateDependencyFile>false</GenerateDependencyFile>
    </PropertyGroup>

</Project>
